# Dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/

# Build, test and packaging output
dist/
coverage/
.nyc_output/
.cache/
*.tsbuildinfo
*.tgz
*.log

# Regenerable example catalog; keep its configuration and source
examples/basic/component-catalog.json

# Internal development records, not user-facing documentation
/VALIDATION.md
/UX-VALIDATION.md
/LIFECYCLE-VALIDATION.md
/PROVENANCE.md

# Local environment values; keep documented templates
.env
.env.*
!.env.example
!.env.*.example

# Editor and operating-system files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

.trial/

# Local evaluation evidence and private trial artifacts (keep minimal fixtures in test/fixtures)
/test/audits/
/docs/optimization-notes.md
/test/baselines/**/*.patch

# Keep only the reusable baseline catalog; evaluation reports/outputs are local
/test/baselines/**/checks.json
/test/baselines/**/config.json
/test/baselines/**/get-outputs.json
/test/baselines/**/metrics.json
/test/baselines/**/queries.json
/test/baselines/**/query-outputs.json
/test/baselines/**/scan-pages.json
/test/baselines/**/trial-report.md
