{
  "extends": "./packages/tsconfig/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["react", "react-dom", "node"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "packages/ui/components/**/*.ts",
    "packages/ui/components/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
