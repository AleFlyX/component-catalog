{
  "configVersion": 2,
  "projectRoot": ".",
  "sourceRoot": "src",
  "tsconfig": "tsconfig.json",
  "catalog": "component-catalog.json",
  "componentRoots": [
    {
      "path": "src/components/ui",
      "idPrefix": "ui",
      "importPrefix": "@/components/ui",
      "importExtension": "omit",
      "layer": "shared-ui",
      "enrollment": "public",
      "reuse": {
        "scope": "project"
      }
    },
    {
      "path": "src/features/auth/components",
      "idPrefix": "auth",
      "importPrefix": "@/features/auth/components",
