{
  "configVersion": 2,
  "projectRoot": ".",
  "sourceRoot": "src",
  "tsconfig": "tsconfig.json",
  "catalog": "component-catalog.json",
  "importPathStyle": "direct",
  "componentRoots": [
    {
      "path": "src/components/common",
      "idPrefix": "common",
      "importPrefix": "@/components/common",
      "layer": "shared-ui",
      "enrollment": "public",
      "reuse": {
        "scope": "project"
      }
    },
    {
      "path": "src/components/business",
      "idPrefix": "business",
      "importPrefix": "@/components/business",
      "layer": "shared-ui",
      "enrollment": "public",
      "reuse": {
        "scope": "project"
      }
    },
    {
      "path": "src/features/auth",
      "idPrefix": "auth",
      "importPrefix": "@/features/auth",
      "layer": "feature",
      "enrollment": "review",
      "reuse": {
        "scope": "module",
        "owner": "auth"
      }
    },
    {
      "path": "src/features/flight-delay-compensation",
      "idPrefix": "flight-delay",
      "importPrefix": "@/features/flight-delay-compensation",
      "layer": "feature",
      "enrollment": "review",
      "reuse": {
        "scope": "module",
        "owner": "flight-delay"
      }
    },
    {
      "path": "src/features/traveler-bookings",
      "idPrefix": "bookings",
      "importPrefix": "@/features/traveler-bookings",
      "layer": "feature",
      "enrollment": "review",
      "reuse": {
        "scope": "module",
        "owner": "bookings"
      }
    },
    {
      "path": "src/components/ui",
      "idPrefix": "ui",
      "importPrefix": "@/components/ui",
      "layer": "shared-ui",
      "enrollment": "public",
      "reuse": {
        "scope": "project"
      }
    }
  ],
